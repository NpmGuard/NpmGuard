NPMGUARD_ENV=dev
NPMGUARD_API_HOST=0.0.0.0
NPMGUARD_API_PORT=8000
NPMGUARD_DATABASE_URL=sqlite+aiosqlite:///../data/npmguard.sqlite3

NPMGUARD_LLM_BACKEND=openai_compatible
NPMGUARD_LLM_BASE_URL=https://openrouter.ai/api/v1
NPMGUARD_LLM_API_KEY=REPLACE_ME
# The model pair is declared ONCE, in config.py, and deliberately not repeated
# here — a second copy is what let a stale pair ship for months. Override per
# host with NPMGUARD_TRIAGE_MODEL / NPMGUARD_INVESTIGATION_MODEL if you must.

NPMGUARD_PAYMENT_REQUIRED=true
NPMGUARD_STRIPE_SECRET_KEY=REPLACE_ME
NPMGUARD_STRIPE_WEBHOOK_SECRET=REPLACE_ME
NPMGUARD_AUDIT_PRICE_CENTS=500

NPMGUARD_BASE_SEPOLIA_CONTRACT=REPLACE_ME
NPMGUARD_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NPMGUARD_CORS_ORIGIN=https://npmguard.com
