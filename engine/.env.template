NPMGUARD_ENV=dev
NPMGUARD_API_HOST=0.0.0.0
NPMGUARD_API_PORT=8000
NPMGUARD_DATABASE_URL=sqlite+aiosqlite:///../data/npmguard.sqlite3

# === INFERENCE SWITCH =======================================================
# Change this ONE line to move the whole audit pipeline between providers. Each
# preset resolves its own endpoint, model catalogue, fallback chain and adapter,
# so nothing else needs to change:
#
#   openrouter  → OpenRouter          (the pre-0G setup; good for demos)
#   zerog       → 0G Compute Router   (TEE-attested, verifiable inference)
#   anthropic | google                (direct vendor endpoints)
#   openai_compatible                 (any other endpoint; needs LLM_BASE_URL)
#
# NPMGUARD_LLM_API_KEY is read for whichever preset is selected. OPENROUTER_API_KEY
# and ZEROG_API_KEY are honoured as fallbacks, so both keys can live side by side
# and flipping the backend needs no key edit.
NPMGUARD_LLM_BACKEND=openrouter
NPMGUARD_LLM_API_KEY=REPLACE_ME

# --- OpenRouter models (used when BACKEND=openrouter) ---
NPMGUARD_TRIAGE_MODEL=deepseek/deepseek-v3.2
NPMGUARD_INVESTIGATION_MODEL=z-ai/glm-5

# --- 0G Compute models (used when BACKEND=zerog) ---
# Get a key at https://pc.0g.ai — connect wallet, deposit 0G, generate.
# Only the MAINNET router serves models usable for code audit; the testnet router
# carries two multimodal models. The Router is a metered service with its own
# balance, independent of which 0G chain the contracts live on.
# NPMGUARD_ZEROG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
# NPMGUARD_ZEROG_TRIAGE_MODEL=deepseek-v4-flash
# NPMGUARD_ZEROG_INVESTIGATION_MODEL=deepseek-v4-flash

NPMGUARD_PAYMENT_REQUIRED=true
NPMGUARD_STRIPE_SECRET_KEY=REPLACE_ME
NPMGUARD_STRIPE_WEBHOOK_SECRET=REPLACE_ME
NPMGUARD_AUDIT_PRICE_CENTS=500

NPMGUARD_BASE_SEPOLIA_CONTRACT=REPLACE_ME
NPMGUARD_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- 0G Chain settlement ----------------------------------------------------
# The same NpmGuardAuditRequest contract on another EVM chain. A chain is only
# offered to clients once its contract address is set here.
# Galileo testnet is chain id 16602 (eth_chainId → 0x40da); faucet: faucet.0g.ai
# NPMGUARD_ZEROG_TESTNET_CONTRACT=0x...
NPMGUARD_ZEROG_TESTNET_RPC_URL=https://evmrpc-testnet.0g.ai
# 0G Aristotle mainnet is chain id 16661
# NPMGUARD_ZEROG_CONTRACT=0x...
NPMGUARD_ZEROG_RPC_URL=https://evmrpc.0g.ai

# --- 0G Storage + attestation relayer ---------------------------------------
# NPMGUARD_ZEROG_RELAYER_KEY is a SECRET (hex private key). It pays for storage
# submissions and writes attestation rows. Never logged, never leaves the engine
# — the CLI has no private-key path and must never gain one.
# Everything 0G-storage-shaped is inert until this is set.
NPMGUARD_ZEROG_NETWORK=testnet
# NPMGUARD_ZEROG_RELAYER_KEY=0x...
# NPMGUARD_ZEROG_ATTESTATIONS_CONTRACT=0x...
# NPMGUARD_ZEROG_STORAGE_INDEXER_URL=   # defaults per network (turbo tier)
# Publish finished audit reports to 0G Storage as a public, tamper-evident copy.
# Best-effort and strictly after the terminal frame: it can never fail an audit.
NPMGUARD_ZEROG_MIRROR_REPORTS=false

NPMGUARD_CORS_ORIGIN=https://npmguard.com

# --- World ID publisher attestation -----------------------------------------
# Create an app at https://developer.world.org → app id, RP id, signing key.
# NPMGUARD_WORLD_SIGNING_KEY is a SECRET (32 bytes hex) and is never logged.
# Leave unset and every /attest route returns 503.
# NPMGUARD_WORLD_APP_ID=app_...
# NPMGUARD_WORLD_RP_ID=rp_...
# NPMGUARD_WORLD_SIGNING_KEY=...
NPMGUARD_WORLD_ENVIRONMENT=staging
# Which credential a publisher proves with: proof_of_human | passport | mnc.
# All three bind the release signal, so the artifact binding is identical; they
# differ only in what the credential says about the human. `proof_of_human` (the
# Orb credential) is the right default for npm.
# A World ID that holds a passport may hold no Orb credential at all — that is a
# `credential_unavailable` the publisher cannot fix on the spot, so this is
# operator-configurable. The World SIMULATOR's test identities are document
# identities, so testing against it needs `passport` here.
# A passport/MNC proof reaches tier 2 on its own: `issuer_schema_id` proves a
# document backed it WITHOUT requesting a single identity attribute.
NPMGUARD_WORLD_CREDENTIAL=proof_of_human
# Allow legacy (v3) proofs. Off by default — an attestation must not quietly
# mean something weaker. When on, the protocol version is recorded per proof.
NPMGUARD_WORLD_ALLOW_LEGACY_PROOFS=false
# The action scopes the nullifier — NEVER change it after go-live, or every
# publisher gets a new pseudonym and every continuity streak silently resets.
NPMGUARD_WORLD_ACTION=attest-npm-release

# DEV ONLY: skip the GitHub push-access check so the World ID half can be tested
# without a configured GitHub App. Refused outright when WORLD_ENVIRONMENT is
# production; attestations made this way record ownership_proven:false.
NPMGUARD_ATTEST_DEV_TRUST_OWNERSHIP=false
