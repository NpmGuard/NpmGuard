node_modules
.venv/
__pycache__/
*.py[cod]
*.sqlite3
*.sqlite3-*
.DS_Store
.env
.env.bck
.env.*.bck
# Local cloud credentials are secrets, regardless of which subproject reads them.
.aws
**/.aws
openclaw/.env.gateway
dist
build
coverage
.cache
*.tsbuildinfo

videos

# Bench malware fixtures — actively malicious npm packages extracted from the
# Datadog corpus. Regenerable via `npm run -w @npmguard/bench datadog:fetch`.
# NEVER commit these to git — they would re-host live malware in this repo.
sandbox/test-fixtures/test-pkg-bench-dd-*/

# Bench runner manifest is regenerable from bench/dataset/datadog/corpus.json.
bench/dataset/manifest.json

# Runtime data — generated outputs, persisted per-environment. Don't commit
# local test runs.
data/
audit-logs*/

# Sandbox runtime deps installed at bench time.
sandbox/package.json
sandbox/package-lock.json
sandbox/node_modules/

# Claude Code session transcript dumps accidentally left in the repo root.
# e.g. 2026-05-04-220442-this-session-is-being-continued-from-a-previous-c.txt
[0-9][0-9][0-9][0-9]-*-this-session-is-being-continued-from-a-previous-*.txt

# Agent worktrees (git worktree checkouts, never repo content).
.claude/worktrees/

# Playwright writes these relative to its CWD. `frontend/.gitignore` already
# covers a run started from `frontend/`, but the e2e suite is just as often
# driven from the workspace root (npm workspaces, an IDE runner, an agent), and
# then the artifacts land HERE where nothing was ignoring them — which is how
# four error-context.md files and a .last-run.json once reached a commit.
# Ignored at both levels on purpose: the run's CWD is not something a
# contributor should have to remember.
test-results/
playwright-report/
blob-report/

# A screenshot path built from an unset env var interpolates to the literal
# "undefined", which no other rule here anticipates. Four PNGs reached a commit
# that way; this is the cheap guard against the next four.
undefined/

# The home for the facts the repo rule keeps OUT of the repo — what is running
# on this machine, what this checkout's `.env` holds, which throwaway cloud
# objects and dirty test-repo state a session left behind. Ignored rather than
# absent: the note has to sit next to the code to get read, and it must never be
# committed, because every line of it is false on somebody else's machine.
LOCAL-STATE.md

# forge's dependency lock. The submodule gitlink in .gitmodules already pins
# forge-std, and two locks for one dependency can disagree.
contracts/foundry.lock
